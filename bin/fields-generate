#!/usr/bin/env php
<?php

declare(strict_types=1);

use Parisek\DefinitionKit\Support\StructuralType;
use Parisek\DefinitionKit\Generator\AcfJsonWriter;
use Parisek\DefinitionKit\Generator\BlockJsonGenerator;
use Parisek\DefinitionKit\Generator\BlockJsonWriter;
use Parisek\DefinitionKit\Generator\FieldsGenerator;
use Parisek\DefinitionKit\Support\KeyStyle;
use Parisek\DefinitionKit\Support\EntryDefinition;
use Parisek\DefinitionKit\Schema\FieldsSchemaValidator;
use Parisek\DefinitionKit\Drupal\ConfigStore;
use Parisek\DefinitionKit\Drupal\DrupalSettings;
use Parisek\DefinitionKit\Generator\Drupal\DrupalConfigWriter;
use Parisek\DefinitionKit\Generator\Drupal\DrupalGenerator;
use Parisek\DefinitionKit\Generator\Drupal\PlanEntry;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

/**
 * @return array{ok: bool, component: string, out?: string, error?: string, skipped?: string, entry?: true}
 */
function fields_generate_one(string $componentDir, bool $dryRun, KeyStyle $keyStyle): array
{
    $componentDir = rtrim($componentDir, '/');
    $componentName = basename($componentDir);
    $yamlPath = "{$componentDir}/{$componentName}.yaml";

    if (null !== ($entryType = EntryDefinition::typeOfDirectory($componentDir))) {
        return ['ok' => true, 'component' => $componentName, 'entry' => true, 'skipped' => EntryDefinition::skipReason($entryType)];
    }

    if (!is_file($yamlPath)) {
        return ['ok' => false, 'component' => $componentName, 'error' => "no {$componentName}.yaml at {$yamlPath}"];
    }

    $validation = (new FieldsSchemaValidator())->validateFile($yamlPath);
    if (!$validation->valid) {
        $messages = array_map(
            static fn (array $e): string => "{$e['pointer']}: {$e['message']}",
            $validation->errors,
        );
        return ['ok' => false, 'component' => $componentName, 'error' => 'invalid definition: ' . implode('; ', $messages)];
    }

    $tree = StructuralType::parseFile($yamlPath);
    if (!is_array($tree)) {
        return ['ok' => false, 'component' => $componentName, 'error' => 'malformed YAML'];
    }

    // Only `kind: block` has CMS projections (ADR 0012 / KindLinter). That
    // holds for BOTH files. A `section`/`element`/`part`/`utility` component
    // registers no block, yet RootFieldGroupBuilder always locates the field
    // group at `block == acf/<slug>` — so its acf.json would be an orphan group
    // attached to a block that does not exist, and its block.json the exact
    // contradiction KindLinter reports as an error. Such a component is
    // reported as SKIP with the same wording fields-lint uses (#69/#70), so
    // generate and lint agree on whether it owns a projection (#72).
    //
    // STOP WRITING, never delete, never refresh: an already-committed acf.json
    // or block.json stays byte-identical (Rule 4, issue #13) until a human
    // removes it or changes the `kind`. fields-lint still compares a committed
    // acf.json, so a leftover is never silently trusted.
    //
    // The gate deliberately triggers only on a PRESENT, non-block `kind`. A
    // definition with no `kind` at all keeps the previous behaviour, because
    // absence means "the backfill has not reached this file", not "not a
    // block" — KindLinter warns rather than errors there for the same reason,
    // and inferring from silence would strip the projections from every
    // un-migrated component in a downstream repo. The `!is_string()` branch is
    // unreachable under the closed schema enum and kept for that intent (#50).
    $kind = $tree['kind'] ?? null;
    if (is_string($kind) && 'block' !== $kind) {
        return ['ok' => true, 'component' => $componentName, 'skipped' => "kind {$kind} has no CMS projection"];
    }

    // Preserve the existing acf.json's `modified` timestamp so regeneration is
    // idempotent — otherwise every run stamps `time()` and churns the field on
    // all components, defeating a git-committed generated artifact. Mirrors how
    // DriftLinter injects the committed `modified` for its comparison. Only a
    // brand-new component (no existing acf.json) falls back to the current time.
    $existingAcfPath = "{$componentDir}/acf.json";
    $existingModified = null;
    if (is_file($existingAcfPath)) {
        $existingAcf = json_decode(file_get_contents($existingAcfPath), true);
        if (is_array($existingAcf) && isset($existingAcf['modified']) && is_numeric($existingAcf['modified'])) {
            $existingModified = (int) $existingAcf['modified'];
        }
    }

    try {
        $fieldGroup = (new FieldsGenerator(keyStyle: $keyStyle))->generate($tree, $componentName, $existingModified ?? time());
    } catch (\Throwable $e) {
        // Broad on purpose: AbstractTypeReverseMapper throws DomainException
        // for an unsupported abstract type/kind/shape/of combination — one
        // bad component must be reported and skipped, not abort the batch.
        return ['ok' => false, 'component' => $componentName, 'error' => $e->getMessage()];
    }

    $existingBlockJsonPath = "{$componentDir}/block.json";
    $existingBlockJson = is_file($existingBlockJsonPath)
        ? json_decode(file_get_contents($existingBlockJsonPath), true)
        : null;

    $block = (new BlockJsonGenerator())->generate(
        $tree,
        $componentName,
        is_array($existingBlockJson) ? $existingBlockJson : null,
    );

    $acfOutPath = $dryRun ? tempnam(sys_get_temp_dir(), 'fields-generate-dry-run-acf-') : "{$componentDir}/acf.json";
    $blockOutPath = $dryRun ? tempnam(sys_get_temp_dir(), 'fields-generate-dry-run-block-') : $existingBlockJsonPath;

    // Rule 4 (issue #13) — `null` means the definition has zero projecting
    // (`acf: true`) fields. Deletion semantics are explicit and deliberate:
    // generation never deletes a stale acf.json on disk — a component that
    // transitions from producing one to not producing one keeps whatever
    // is already committed until a human/CI removes it. DriftLinter is the
    // gate that reports that leftover file as drift; this script's job is
    // only to stop WRITING a fresh (now meaningless) one.
    $acfWritten = null !== $fieldGroup;
    if ($acfWritten) {
        try {
            (new AcfJsonWriter())->write($fieldGroup, $acfOutPath);
        } catch (\Throwable $e) {
            if ($dryRun) {
                @unlink($acfOutPath);
            }
            return ['ok' => false, 'component' => $componentName, 'error' => $e->getMessage()];
        }
    }

    try {
        (new BlockJsonWriter())->write($block, $blockOutPath);
    } catch (\Throwable $e) {
        if ($dryRun) {
            if ($acfWritten) {
                @unlink($acfOutPath);
            }
            @unlink($blockOutPath);
        }
        return ['ok' => false, 'component' => $componentName, 'error' => $e->getMessage()];
    }

    if ($dryRun) {
        if ($acfWritten) {
            @unlink($acfOutPath);
        }
        @unlink($blockOutPath);
        return ['ok' => true, 'component' => $componentName];
    }

    return ['ok' => true, 'component' => $componentName] + ($acfWritten ? ['out' => $acfOutPath] : []);
}

/**
 * `--target=drupal` (ADR 0002): plan the paragraph config of every component
 * against one export, print the plan, and write it only when nothing is
 * refused and no component failed.
 *
 * @param list<string> $dirs
 */
function fields_generate_drupal(array $dirs, string $settingsRoot, string $configDir, bool $dryRun, ?string $namesOut): int
{
    try {
        $store = new ConfigStore($configDir);
        $settings = DrupalSettings::discoverFor($settingsRoot);
        $generator = new DrupalGenerator($store, $settings);
    } catch (\RuntimeException $e) {
        fwrite(STDERR, $e->getMessage() . "\n");

        return 2;
    }

    echo "drupal config: {$store->directory()} (" . count($store->names('paragraphs.paragraphs_type.')) . " paragraph types)\n";
    if (null !== $settings->path) {
        echo "settings: {$settings->path}\n";
    }

    $result = $generator->run($dirs);
    $failed = 0;
    $skipped = 0;
    foreach ($result['components'] as $component) {
        match ($component['status']) {
            'OK' => print("OK   {$component['component']} ({$component['detail']})\n"),
            'SKIP' => print("SKIP {$component['component']}: {$component['detail']}\n"),
            default => print("FAIL {$component['component']}: {$component['detail']}\n"),
        };
        $failed += 'FAIL' === $component['status'] ? 1 : 0;
        $skipped += 'SKIP' === $component['status'] ? 1 : 0;
    }
    echo sprintf(
        "%d component(s), %d failed%s\n",
        count($result['components']),
        $failed,
        $skipped > 0 ? sprintf(', %d skipped', $skipped) : '',
    );

    $plan = $result['plan'];
    echo "\nplan:\n";
    foreach ($plan->entries as $entry) {
        echo $entry->line() . "\n";
    }
    echo $plan->summary() . "\n";

    $blocked = $failed > 0 || $plan->refused();
    if (null !== $namesOut) {
        // A blocked run writes no config, so it names none: an empty file,
        // never a list of files that do not exist.
        $blocked
            ? file_put_contents($namesOut, '')
            : (new DrupalConfigWriter())->writeNames($plan, $namesOut);
    }

    if ($blocked) {
        echo "nothing written: " . ($plan->refused() ? 'the plan refuses ' . count($plan->withAction(PlanEntry::REFUSE)) . ' config entit(y/ies)' : "{$failed} component(s) failed") . "\n";

        return 1;
    }
    if ($dryRun) {
        echo "dry run: nothing written\n";

        return 0;
    }
    $written = (new DrupalConfigWriter())->write($plan, $store);
    echo 'wrote ' . count($written) . " file(s)\n";

    return 0;
}

$args = array_slice($argv, 1);
$root = null;
$dryRun = false;
$single = null;
$target = 'wp';
$drupalConfig = null;
$namesOut = null;

$usage = "usage: fields-generate <component-dir> | fields-generate --root=<components-root> [--dry-run]\n"
    . "       fields-generate --target=drupal --drupal-config=<config-dir> (<component-dir> | --root=<components-root>)\n"
    . "                       [--dry-run] [--names-out=<file>]\n"
    . "  --target=drupal plans paragraph config against a drush config:export directory and\n"
    . "  merges it in: REUSE, CREATE, UPDATE, REFUSE per config entity (ADR 0002). A REFUSE or a\n"
    . "  failed component writes nothing. --names-out lists created and changed config names.\n";

foreach ($args as $arg) {
    if (str_starts_with($arg, '--root=')) {
        $root = substr($arg, 7);
        continue;
    }
    if ('--dry-run' === $arg) {
        $dryRun = true;
        continue;
    }
    if (str_starts_with($arg, '--target=')) {
        $target = substr($arg, 9);
        if (!in_array($target, ['wp', 'drupal'], true)) {
            fwrite(STDERR, "unknown target: {$target} (expected wp|drupal)\n" . $usage);
            exit(2);
        }
        continue;
    }
    if (str_starts_with($arg, '--drupal-config=')) {
        $drupalConfig = substr($arg, 16);
        continue;
    }
    if (str_starts_with($arg, '--names-out=')) {
        $namesOut = substr($arg, 12);
        continue;
    }
    // An unrecognised option must never fall through to $single. This command
    // WRITES acf.json/block.json unless --dry-run is set, so swallowing a
    // misspelled or invented flag turns an intended no-op into an overwrite:
    // `fields-generate --check <dir>` reads like a read-only check and instead
    // rewrites the working tree.
    if (str_starts_with($arg, '-')) {
        fwrite(STDERR, "unknown option: {$arg}\n" . $usage);
        exit(2);
    }
    $single = $arg;
}

if (null === $root && null === $single) {
    fwrite(STDERR, $usage);
    exit(2);
}

if (null !== $root && !is_dir($root)) {
    fwrite(STDERR, "not a directory: {$root}\n");
    exit(2);
}

if ('drupal' === $target) {
    if (null === $drupalConfig || '' === $drupalConfig || (null !== $root && null !== $single)) {
        fwrite(STDERR, $usage);
        exit(2);
    }
    if (null !== $single && !is_dir($single)) {
        fwrite(STDERR, "not a directory: {$single}\n");
        exit(2);
    }
    $dirs = null !== $root ? (glob(rtrim($root, '/') . '/*', GLOB_ONLYDIR) ?: []) : [rtrim((string) $single, '/')];
    sort($dirs);
    if (null !== $root) {
        $dirs = array_values(array_filter($dirs, static fn (string $d): bool => is_file("{$d}/" . basename($d) . '.yaml')));
    }
    exit(fields_generate_drupal($dirs, $root ?? dirname(rtrim((string) $single, '/')), $drupalConfig, $dryRun, $namesOut));
}
if (null !== $drupalConfig || null !== $namesOut) {
    fwrite(STDERR, "--drupal-config and --names-out need --target=drupal\n" . $usage);
    exit(2);
}

// The key style governs how a component slug is spelled inside derived ACF
// keys. Resolved from the components root (not per component) because it is a
// project-wide convention: two components in one project spelling their keys
// differently is the exact split this setting exists to end.
$keyStyle = KeyStyle::discoverFor($root ?? dirname(rtrim((string) $single, '/')));

$results = [];
if (null !== $root) {
    $dirs = glob(rtrim($root, '/') . '/*', GLOB_ONLYDIR) ?: [];
    sort($dirs);
    foreach ($dirs as $dir) {
        $name = basename($dir);
        if (is_file("{$dir}/{$name}.yaml")) {
            $results[] = fields_generate_one($dir, $dryRun, $keyStyle);
        }
    }
} else {
    $results[] = fields_generate_one($single, $dryRun, $keyStyle);
}

$failures = 0;
$skipped = 0;
$entries = 0;
foreach ($results as $result) {
    if ($result['ok']) {
        // A page or doc is not a component: it is left out of the
        // "component(s)" total and the skip count, as in fields-lint.
        if (isset($result['entry'])) {
            $entries++;
        } elseif (isset($result['skipped'])) {
            $skipped++;
        }
        echo isset($result['skipped'])
            ? "SKIP {$result['component']}: {$result['skipped']}\n"
            : "OK   {$result['component']}" . (isset($result['out']) ? " -> {$result['out']}" : '') . "\n";
        continue;
    }
    $failures++;
    echo "FAIL {$result['component']}: {$result['error']}\n";
}
// Same shape as fields-lint (#70): the skip count is appended, never
// inserted, and omitted when zero, so a run with nothing skipped prints the
// line it always printed.
echo sprintf(
    "%d component(s), %d failed%s\n",
    count($results) - $entries,
    $failures,
    $skipped > 0 ? sprintf(', %d skipped', $skipped) : '',
);

exit($failures > 0 ? 1 : 0);
