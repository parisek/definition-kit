#!/usr/bin/env php
<?php

declare(strict_types=1);

use Parisek\DefinitionKit\Contract\CallSiteIndex;
use Parisek\DefinitionKit\Contract\RoleProposal;
use Parisek\DefinitionKit\Contract\RoleProposer;
use Parisek\DefinitionKit\Migration\FieldsYamlWriter;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

// Bootstrap `role:` across a project from evidence (issue #27, phase 4).
//
// Prints proposals by default and writes nothing. `--write` applies them.
// Whatever it cannot evidence is left blank and listed, and the blank rate is
// printed at the end of every run — roughly one prop in five on a real project.
// That is a designed property of proposing-rather-than-guessing, and printing
// it is how it stays expected instead of being discovered halfway through a
// review.

$args = array_slice($argv, 1);
$root = null;
$single = null;
$write = false;
$callSiteRoot = null;

foreach ($args as $arg) {
    if ('--write' === $arg) {
        $write = true;
        continue;
    }
    if (str_starts_with($arg, '--root=')) {
        $root = substr($arg, 7);
        continue;
    }
    if (str_starts_with($arg, '--call-sites=')) {
        $callSiteRoot = substr($arg, 13);
        continue;
    }
    $single = $arg;
}

if (null === $root && null === $single) {
    fwrite(
        STDERR,
        "usage: fields-roles [--write] <component-dir>\n"
        . "       fields-roles [--write] [--call-sites=<dir>] --root=<components-root>\n",
    );
    exit(2);
}

if (null !== $root && !is_dir($root)) {
    fwrite(STDERR, "not a directory: {$root}\n");
    exit(2);
}

/** @return list<string> */
function fields_roles_twigs(string $dir): array
{
    if (!is_dir($dir)) {
        return [];
    }

    $found = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveCallbackFilterIterator(
            new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS),
            static fn (SplFileInfo $file): bool => !$file->isDir()
                || !in_array($file->getFilename(), ['node_modules', 'vendor', '.git'], true),
        ),
    );

    foreach ($iterator as $file) {
        if ($file instanceof SplFileInfo && 'twig' === $file->getExtension()) {
            $found[] = $file->getPathname();
        }
    }

    sort($found);

    return $found;
}

$dirs = null !== $root
    ? (glob(rtrim($root, '/') . '/*', GLOB_ONLYDIR) ?: [])
    : [rtrim($single, '/')];
sort($dirs);

// `role: parent` is only proposable with call sites to point at, and those
// live in OTHER components' templates. A single-component run has none, so it
// says so rather than silently proposing less.
// Call sites are not confined to the components directory. `footer` and
// `header` in a real theme are rendered by `page/_partials/*.twig`, one level
// up and outside the sweep -- scanning only the components root left every one
// of their props with no evidence. The default is therefore the PARENT of the
// components root, walked recursively, which is the theme's template tree in
// the layouts this package targets. `--call-sites=` overrides it.
//
// `styleguide.*.twig` fixtures count too: they pass exactly the props a real
// caller passes, and for a component with no ACF layer they are often the only
// call sites there are. An ACF field still wins over a call site, so demo data
// cannot relabel a genuine `field` prop.
$twigs = [];
if (null !== $root) {
    $searchRoot = $callSiteRoot ?? dirname(rtrim($root, '/'));
    $twigs = fields_roles_twigs($searchRoot);
    echo sprintf("call sites: %d template(s) under %s\n\n", count($twigs), $searchRoot);
}
$callSites = null !== $root ? new CallSiteIndex($twigs) : null;

if (null === $callSites) {
    echo "note: single-component run — `role: parent` cannot be proposed without the call sites\n"
        . "      in other components' templates. Use --root=<components-root> for that.\n\n";
}

// Proposing and checking must agree on what the framework supplies, so both
// resolve the baseline the same way.
$proposer = RoleProposer::forComponentsRoot($root ?? dirname(rtrim((string) $single, '/')));
$writer = new FieldsYamlWriter();

$proposed = 0;
$blank = 0;
$skipped = 0;
$written = 0;
$failed = 0;

foreach ($dirs as $dir) {
    $proposal = $proposer->propose($dir, $callSites);

    if (null !== $proposal->skipped) {
        $skipped++;
        echo "SKIP {$proposal->component}: {$proposal->skipped}\n";
        continue;
    }

    $proposed += $proposal->proposedCount();
    $blank += count($proposal->unresolved);

    if (!$proposal->hasChanges() && [] === $proposal->unresolved) {
        echo "OK   {$proposal->component}: every prop already carries a role\n";
        continue;
    }

    echo "{$proposal->component}\n";

    foreach ($proposal->roles as $prop => $role) {
        $from = isset($proposal->derivedFrom[$prop]) ? " (from: {$proposal->derivedFrom[$prop]})" : '';
        echo "  + {$prop}: role: {$role}{$from}\n";
    }

    foreach ($proposal->baselineProps as $prop) {
        echo "  · {$prop}: injected by the framework — deliberately not declared\n";
    }

    foreach ($proposal->unresolved as $prop) {
        $hint = $proposal->hints[$prop] ?? 'no evidence for any role';
        echo "  ? {$prop}: {$hint} — left for you\n";
    }

    if ($write && $proposal->hasChanges() && null !== $proposal->definition) {
        $path = $dir . '/' . $proposal->component . '.yaml';
        try {
            $writer->write($proposal->definition, $path);
            $written++;
            echo "  written: {$path}\n";
        } catch (\Throwable $e) {
            $failed++;
            echo "  FAILED to write {$path}: {$e->getMessage()}\n";
        }
    }
}

$considered = $proposed + $blank;
$rate = $considered > 0 ? round(100 * $blank / $considered) : 0;

echo sprintf(
    "\n%d component(s): %d role(s) proposed, %d left blank (%d%%), %d skipped\n",
    count($dirs),
    $proposed,
    $blank,
    $rate,
    $skipped,
);

if (!$write) {
    echo "nothing written — re-run with --write to apply\n";
} else {
    echo sprintf("%d file(s) written, %d failed\n", $written, $failed);
}

exit($failed > 0 ? 1 : 0);
