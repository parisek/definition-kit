#!/usr/bin/env php
<?php

declare(strict_types=1);

use Parisek\DefinitionKit\Baseline\FrameworkProps;
use Parisek\DefinitionKit\Contract\ContractLinter;
use Parisek\DefinitionKit\Contract\ContractResult;
use Parisek\DefinitionKit\Lint\DriftLinter;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

/** @return array{status: 'ok'|'drift'|'skip'|'fail', component: string, acfDrift?: list<string>, blockDrift?: list<string>, reason?: string} */
function fields_lint_one(string $componentDir): array
{
    $componentDir = rtrim($componentDir, '/');
    $componentName = basename($componentDir);
    $yamlPath = "{$componentDir}/{$componentName}.yaml";

    if (!is_file($yamlPath)) {
        return ['status' => 'skip', 'component' => $componentName, 'reason' => "no {$componentName}.yaml yet"];
    }

    $result = (new DriftLinter())->lint($componentDir);

    if (null !== $result->error) {
        return ['status' => 'fail', 'component' => $componentName, 'reason' => $result->error];
    }
    if (!$result->clean) {
        return ['status' => 'drift', 'component' => $componentName, 'acfDrift' => $result->acfDrift, 'blockDrift' => $result->blockDrift];
    }
    return ['status' => 'ok', 'component' => $componentName];
}

$args = array_slice($argv, 1);
$root = null;
$single = null;
// Drift is a CMS-projection check: it compares a definition against the
// acf.json/block.json generated from it. A CMS-agnostic skeleton has neither —
// tailwind-base generates its projections downstream — so every component
// reports "acf.json missing" and the input-contract half, which is perfectly
// meaningful there, is unusable as a gate underneath the noise.
$contractOnly = false;

foreach ($args as $arg) {
    if ('--contract-only' === $arg) {
        $contractOnly = true;
        continue;
    }
    if (str_starts_with($arg, '--root=')) {
        $root = substr($arg, 7);
        continue;
    }
    $single = $arg;
}

if (null === $root && null === $single) {
    fwrite(
        STDERR,
        "usage: fields-lint [--contract-only] <component-dir>\n"
        . "       fields-lint [--contract-only] --root=<components-root>\n",
    );
    exit(2);
}

if (null !== $root && !is_dir($root)) {
    fwrite(STDERR, "not a directory: {$root}\n");
    exit(2);
}

// The baseline that governs this components root — a project's own
// `framework-props-baseline.yaml` when it ships one, otherwise the shipped
// timber-kit table. What the framework supplies is a fact about the framework
// in front of you, not about this package.
$baselineRoot = $root ?? dirname(rtrim((string) $single, '/'));
$baseline = FrameworkProps::discoverFor($baselineRoot);
$contractLinter = new ContractLinter($baseline['props']);
if (null !== $baseline['path']) {
    echo "framework props: {$baseline['path']}\n";
}

/** @var list<ContractResult> $contractResults */
$contractResults = [];

$results = [];
if (null !== $root) {
    $dirs = glob(rtrim($root, '/') . '/*', GLOB_ONLYDIR) ?: [];
    sort($dirs);
    foreach ($dirs as $dir) {
        if (!$contractOnly) {
            $results[] = fields_lint_one($dir);
        }
        $contractResults[] = $contractLinter->lint($dir);
    }
} else {
    if (!$contractOnly) {
        $results[] = fields_lint_one($single);
    }
    $contractResults[] = $contractLinter->lint($single);
}

$failures = 0;
foreach ($results as $result) {
    switch ($result['status']) {
        case 'ok':
            echo "OK   {$result['component']}\n";
            break;
        case 'skip':
            echo "SKIP {$result['component']}: {$result['reason']}\n";
            break;
        case 'drift':
            $failures++;
            echo "DRIFT {$result['component']}\n";
            if ([] !== $result['acfDrift']) {
                echo "  acf.json:\n";
                foreach ($result['acfDrift'] as $line) {
                    echo "    {$line}\n";
                }
            }
            if ([] !== $result['blockDrift']) {
                echo "  block.json:\n";
                foreach ($result['blockDrift'] as $line) {
                    echo "    {$line}\n";
                }
            }
            echo "  fix: vendor/bin/fields-generate {$result['component']}\n";
            break;
        case 'fail':
            $failures++;
            echo "FAIL {$result['component']}: {$result['reason']}\n";
            break;
    }
}
// --- input contract (issue #27) --------------------------------------------
//
// Reported separately from drift, and gated per component: only a definition
// whose every field carries a role is checked for real. Everything else is
// listed as untyped, which is deliberately not the same as passing — a run
// that says "40 OK" while 35 of them were never checked is how a lint stops
// being believed.
$contractFailures = 0;
$brokenRefs = 0;
$typed = 0;
$untyped = 0;
$unanalysed = 0;

echo "\ninput contract:\n";
foreach ($contractResults as $contract) {
    switch ($contract->status) {
        case ContractResult::TYPED:
            $typed++;
            echo $contract->isFailure()
                ? "  BROKEN REF {$contract->component}\n"
                : "  OK        {$contract->component}\n";
            break;
        case ContractResult::VIOLATIONS:
            $typed++;
            $contractFailures++;
            $failures++;
            echo "  UNDECLARED {$contract->component}\n";
            foreach ($contract->violations as $prop) {
                echo "    {$contract->component}.twig reads `content.{$prop}`, which no role accounts for\n";
            }
            echo "    fix: declare it under `fields:` with the role it comes from "
                . "(field/query/global/parent/inherited/derived)\n";
            break;
        case ContractResult::UNTYPED:
            $untyped++;
            echo "  UNTYPED   {$contract->component}: {$contract->reason}\n";
            break;
        case ContractResult::UNANALYSED:
            $unanalysed++;
            echo "  UNREAD    {$contract->component}: {$contract->reason}\n";
            break;
    }

    foreach ($contract->notes as $note) {
        echo "    [{$note['kind']}] {$note['detail']}\n";
    }

    // A note that is a defect rather than a caveat — an `of:` target that does
    // not resolve — has to reach the exit code, or the gate passes on a
    // definition whose shape nobody can read.
    if (ContractResult::VIOLATIONS !== $contract->status && $contract->isFailure()) {
        $brokenRefs++;
        $failures++;
    }
}

echo sprintf(
    "  %d typed (%d with undeclared props%s), %d untyped, %d unanalysed\n",
    $typed,
    $contractFailures,
    $brokenRefs > 0 ? sprintf(', %d with a broken `of:` target', $brokenRefs) : '',
    $untyped,
    $unanalysed,
);

echo sprintf("%d component(s), %d failed\n", count($contractResults), $failures);

exit($failures > 0 ? 1 : 0);
