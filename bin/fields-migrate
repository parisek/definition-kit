#!/usr/bin/env php
<?php

declare(strict_types=1);

use Parisek\DefinitionKit\Drupal\BundleResolver;
use Parisek\DefinitionKit\Drupal\DisplayEvidence;
use Parisek\DefinitionKit\Drupal\DrupalConfig;
use Parisek\DefinitionKit\Drupal\DrupalSettings;
use Parisek\DefinitionKit\Migration\AcfJsonReader;
use Parisek\DefinitionKit\Migration\DrupalParagraphReader;
use Parisek\DefinitionKit\Migration\TwigMetadataReader;
use Parisek\DefinitionKit\Support\KeyStyle;
use Parisek\DefinitionKit\Migration\BlockResidualCapturer;
use Parisek\DefinitionKit\Migration\ComponentCommentMatcher;
use Parisek\DefinitionKit\Migration\FieldsYamlWriter;
use Parisek\DefinitionKit\Migration\EntryMetadataMigrator;
use Parisek\DefinitionKit\Migration\StructuralTypeRenamer;
use Parisek\DefinitionKit\Migration\TwigFrontCommentStripper;
use Parisek\DefinitionKit\Support\EntryDefinition;
use Symfony\Component\Yaml\Yaml;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

/**
 * Writes the whole content or nothing: a short write never replaces the file.
 * Page and doc migration strips the twig comment only after the YAML is complete, so a
 * truncated YAML must not count as written.
 */
function fields_migrate_write_atomically(string $path, string $content): bool
{
    $tmp = $path . '.tmp';
    if (strlen($content) !== file_put_contents($tmp, $content)) {
        @unlink($tmp);
        return false;
    }
    if (!rename($tmp, $path)) {
        @unlink($tmp);
        return false;
    }

    return true;
}

/**
 * Insert $key => $value into $tree right after the last of $after present,
 * so the dumped YAML keeps the front-comment's key order.
 *
 * @param array<string,mixed> $tree
 * @param list<string> $after
 * @return array<string,mixed>
 */
function fields_migrate_insert_after(array $tree, array $after, string $key, mixed $value): array
{
    $out = [];
    $inserted = false;
    $anchor = null;
    foreach ($after as $candidate) {
        if (array_key_exists($candidate, $tree)) {
            $anchor = $candidate;
        }
    }
    if (null === $anchor) {
        return [$key => $value] + $tree;
    }
    foreach ($tree as $k => $v) {
        $out[$k] = $v;
        if ($k === $anchor) {
            $out[$key] = $value;
            $inserted = true;
        }
    }

    return $inserted ? $out : $tree + [$key => $value];
}

/**
 * @param array{config: ?DrupalConfig, settings: DrupalSettings, evidence: ?DisplayEvidence} $drupal
 * @return array{ok: bool, component: string, out?: string, error?: string, skipped?: string, note?: string}
 */
function fields_migrate_one(string $componentDir, bool $dryRun, bool $force, KeyStyle $keyStyle, ?string $assumeRole, array $drupal = ['config' => null, 'settings' => new DrupalSettings(), 'evidence' => null], ?string $defaultCategory = null): array
{
    $componentDir = rtrim($componentDir, '/');
    $componentName = basename($componentDir);
    $acfPath = "{$componentDir}/acf.json";
    $blockPath = "{$componentDir}/block.json";

    $twigPath = "{$componentDir}/{$componentName}.twig";
    $yamlPath = "{$componentDir}/{$componentName}.yaml";

    // Migration derives a definition from acf.json. Anything authored ONLY in
    // the YAML -- `mcp:` guidance, `dev:` notes, a hand-corrected `name:` --
    // is in no other file, so re-migrating over an existing definition deletes
    // it. Running a `--root` sweep on an adopted project cost 430 lines of
    // authored annotation across 52 components before this guard existed, and
    // the loss was invisible in the tool's own output: every component
    // reported OK.
    //
    // Re-deriving after the CMS changed is still legitimate, so `--force`
    // keeps that path -- deliberately, and named in the message.
    if (!$dryRun && !$force && is_file($yamlPath)) {
        return [
            'ok' => true,
            'component' => $componentName,
            'skipped' => "{$componentName}.yaml already exists — migrating would overwrite what only it "
                . 'records (mcp:/dev: guidance, authored labels). Re-derive with --force if that is what you want.',
        ];
    }

    // A page or doc has no acf.json to derive from: its twig front-comment is
    // the whole definition. It moves into the YAML and leaves the twig, so the
    // two sources cannot disagree later (the retirement tailwind-base
    // ADR 0007 did for components).
    if (null !== ($entryType = EntryDefinition::typeOfDirectory($componentDir))) {
        if (!is_file($twigPath)) {
            return ['ok' => false, 'component' => $componentName, 'error' => "no {$componentName}.twig at {$componentDir}"];
        }
        try {
            $entry = (new EntryMetadataMigrator($entryType))->migrate((string) file_get_contents($twigPath), EntryDefinition::schemaHeaderFor($componentDir));
        } catch (\RuntimeException $e) {
            return ['ok' => false, 'component' => $componentName, 'error' => $e->getMessage()];
        }
        if ($dryRun) {
            return ['ok' => true, 'component' => $componentName];
        }
        // YAML first: if the twig write then fails, the metadata exists twice
        // (the YAML wins in the styleguide), never zero times.
        if (!fields_migrate_write_atomically($yamlPath, $entry['yaml'])) {
            return ['ok' => false, 'component' => $componentName, 'error' => "cannot write {$yamlPath}"];
        }
        if (!fields_migrate_write_atomically($twigPath, $entry['twig'])) {
            return ['ok' => false, 'component' => $componentName, 'error' => "wrote {$yamlPath} but cannot strip the front-comment from {$twigPath}"];
        }

        return ['ok' => true, 'component' => $componentName, 'out' => $yamlPath];
    }

    // A Gutenberg block with no editor fields has a block.json and no
    // acf.json -- `divider`, `form-configurator`. Requiring acf.json locked
    // out exactly the components definition-kit 0.4.0 made expressible.
    //
    // A twig with NEITHER file is the next case out: `button`, `picture`,
    // `header`, `breadcrumb` -- utility components rendered by a caller, never
    // by the editor, so no ACF group and no block.json will ever exist for
    // them. In one real 69-component project that is 17 components, and the
    // two most-called in the whole theme (`picture` at 77 call sites,
    // `button` at 31). Refusing them kept the input-contract check blind to
    // exactly the components #14 called load-bearing.
    //
    // The template is the thing being described, so its presence is what makes
    // a directory a component. Only a directory with none of the three is
    // genuinely nothing to migrate.
    if (!is_file($acfPath) && !is_file($blockPath) && !is_file($twigPath)) {
        return [
            'ok' => false,
            'component' => $componentName,
            'error' => "no acf.json, block.json or {$componentName}.twig at {$componentDir}",
        ];
    }

    if (is_file($acfPath)) {
        $decoded = json_decode(file_get_contents($acfPath), true);
        if (!is_array($decoded)) {
            return ['ok' => false, 'component' => $componentName, 'error' => 'invalid JSON in acf.json'];
        }
    } else {
        // Synthesise an empty ACF document. `title` is only a fallback --
        // AcfJsonReader prefers the twig front-comment `name:` -- and the
        // empty field map is what the definition should say: this component
        // has no ACF-backed fields.
        //
        // It deliberately does NOT try to guess non-ACF inputs. A component
        // like form-configurator takes nine values from timber_context(),
        // and no file on disk records that; inferring provenance would be a
        // guess, and a wrong `role:` is worse than an honest empty map the
        // author then fills in. The CLI says so on stdout.
        $blockDecodedForTitle = is_file($blockPath)
            ? json_decode((string) file_get_contents($blockPath), true)
            : null;
        $decoded = [
            // The derived key, so AcfJsonReader sees nothing worth pinning:
            // there is no ACF group here, so the definition should not claim
            // one. (It pins root `key` only when the real key differs from
            // `group_<slug>`; an absent key would pin '' and fail ^group_.)
            'key' => 'group_' . $keyStyle->keySlug($componentName),
            'title' => is_array($blockDecodedForTitle) ? (string) ($blockDecodedForTitle['title'] ?? '') : '',
            'fields' => [],
        ];
    }

    $twigSource = is_file($twigPath) ? file_get_contents($twigPath) : null;

    // A Drupal paragraph type behind the component (see BundleResolver for
    // the order: the root `drupal:` admin link, the snake_case convention,
    // bundle_aliases). With a config export in hand the bundle must exist in
    // it, and the export -- the deployed schema -- becomes the field source.
    // Without one, only the admin link can say so, and the twig `fields:`
    // annotation stays the field source with editor-authored roles.
    $twigMeta = is_string($twigSource) ? (new TwigMetadataReader())->read($twigSource) : [];
    $bundles = (new BundleResolver($drupal['settings']))->resolve($componentName, $twigMeta['drupal'] ?? null, $drupal['config']);
    $bundle = array_key_first($bundles);
    $fromConfig = null !== $bundle && null !== $drupal['config'] && $drupal['config']->hasBundle($bundle) && !is_file($acfPath);
    $paragraphBacked = null !== $bundle && (null === $drupal['config'] ? BundleResolver::SOURCE_LINK === $bundles[$bundle] : $drupal['config']->hasBundle($bundle));
    $note = null;

    try {
        // `acfJsonExists` distinguishes a synthesised empty document (no
        // acf.json at all — the twig annotation, if any, is the sole field
        // source) from a real acf.json that genuinely has zero fields (which
        // must NOT be overridden by a stale twig comment). See AcfJsonReader::read().
        //
        // `$assumeRole` (from `--assume-role`) only matters on that same
        // twig-only path — an acf.json-backed component ignores it entirely,
        // since AcfJsonReader::read() never reaches the twig-fields fallback
        // when acf.json genuinely has fields.
        // With the config as field source, the twig is read for metadata
        // only: `acfJsonExists: true` over the synthesised empty document
        // keeps AcfJsonReader off the twig `fields:` annotation.
        $tree = (new AcfJsonReader(keyStyle: $keyStyle, assumeRole: $assumeRole, paragraphBacked: $paragraphBacked))
            ->read($decoded, $componentName, $twigSource, is_file($acfPath) || $fromConfig);
        if ($fromConfig && null !== $bundle && null !== $drupal['config']) {
            // Every bundle this component's aliases resolve to (not just the
            // primary one) that genuinely exists in the config export — a
            // field present on only some of them comes back scoped with
            // `drupal.bundles` (readMerged()) instead of forcing one bundle's
            // shape onto every alias.
            $aliasedBundles = array_values(array_filter(array_keys($bundles), fn (string $b): bool => $drupal['config']->hasBundle($b)));
            $tree['fields'] = (new DrupalParagraphReader($drupal['config'], $drupal['settings'], $drupal['evidence']))
                ->readMerged([] !== $aliasedBundles ? $aliasedBundles : [$bundle]);
            $note = count($aliasedBundles) > 1
                ? 'fields from Drupal paragraph types ' . implode(', ', $aliasedBundles)
                : "fields from Drupal paragraph type {$bundle}";
            if (is_string($twigSource) && [] !== (new TwigMetadataReader())->readFields($twigSource)) {
                $note .= "; the twig fields: annotation was not used";
            }
        }
        if ($paragraphBacked && !isset($tree['kind'])) {
            $tree = fields_migrate_insert_after($tree, ['name', 'usage', 'category'], 'kind', 'block');
        }
        if (null !== $defaultCategory && !isset($tree['category'])) {
            $tree = fields_migrate_insert_after($tree, ['name', 'usage'], 'category', $defaultCategory);
        }
    } catch (\Throwable $e) {
        // Broad on purpose: AbstractTypeMapper throws DomainException for an
        // unsupported ACF field type; a group/repeater with zero non-accordion
        // sub-fields throws RuntimeException. One bad component must be
        // reported and skipped, not abort the whole batch.
        return ['ok' => false, 'component' => $componentName, 'error' => $e->getMessage()];
    }

    // Capture the sibling block.json's non-derivable config (postTypes /
    // supports / attributes the generator can't reproduce) into root
    // `wp.block`, so block.json round-trips losslessly. Absent/invalid
    // block.json or an all-derivable one leaves the tree untouched.
    if (is_file($blockPath)) {
        $blockDecoded = json_decode(file_get_contents($blockPath), true);
        if (is_array($blockDecoded)) {
            $wpBlock = (new BlockResidualCapturer())->capture($tree, $componentName, $blockDecoded);
            if ([] !== $wpBlock) {
                $tree['wp']['block'] = $wpBlock;
            }
        }
    }

    $outPath = $dryRun
        ? tempnam(sys_get_temp_dir(), 'fields-migrate-dry-run-')
        : $yamlPath;

    try {
        (new FieldsYamlWriter())->write($tree, $outPath);
    } catch (\Throwable $e) {
        if ($dryRun) {
            @unlink($outPath);
        }
        return ['ok' => false, 'component' => $componentName, 'error' => $e->getMessage()];
    }

    if ($dryRun) {
        @unlink($outPath);
        return ['ok' => true, 'component' => $componentName] + (null !== $note ? ['note' => $note] : []);
    }

    // Same retirement page/doc migration already does above: strip the
    // front-comment only now that the yaml it was moved into is written and
    // complete, never before. A component whose twig has no front-comment at
    // all (acf.json-only, no name:/category: block) has nothing to strip.
    if (is_string($twigSource) && (new TwigFrontCommentStripper())->hasFrontComment($twigSource)) {
        $stripped = (new TwigFrontCommentStripper())->strip($twigSource);
        if (!fields_migrate_write_atomically($twigPath, $stripped)) {
            return [
                'ok' => false,
                'component' => $componentName,
                'error' => "wrote {$outPath} but cannot strip the front-comment from {$twigPath}",
            ];
        }
    }

    return ['ok' => true, 'component' => $componentName, 'out' => $outPath] + (null !== $note ? ['note' => $note] : []);
}

$args = array_slice($argv, 1);

// `--rename-structural-types` is a codemod over EXISTING definitions (#79):
// `type: group` -> `object`, `type: repeater` -> `list`. It reads no acf.json
// and no twig, so none of the derivation flags below apply, and combining it
// with one is refused rather than ignored. It prints by default and writes
// only with `--write`, the same shape fields-roles uses for rewriting
// authored definitions.
if (in_array('--rename-structural-types', $args, true)) {
    $renameUsage = "usage: fields-migrate --rename-structural-types [--write] <component-dir>\n"
        . "       fields-migrate --rename-structural-types [--write] --root=<components-root>\n"
        . "  Rewrites `type: group` to `object` and `type: repeater` to `list` in <name>.yaml.\n"
        . "  Prints what would change and writes nothing unless --write is given.\n";
    $write = false;
    $renameRoot = null;
    $renameSingle = null;
    foreach ($args as $arg) {
        if ('--rename-structural-types' === $arg) {
            continue;
        }
        if ('--write' === $arg) {
            $write = true;
            continue;
        }
        if (str_starts_with($arg, '--root=')) {
            $renameRoot = substr($arg, 7);
            continue;
        }
        if (str_starts_with($arg, '-')) {
            fwrite(STDERR, "unknown option with --rename-structural-types: {$arg}\n" . $renameUsage);
            exit(2);
        }
        $renameSingle = $arg;
    }
    if ((null === $renameRoot) === (null === $renameSingle)) {
        fwrite(STDERR, $renameUsage);
        exit(2);
    }
    $scanDir = $renameRoot ?? $renameSingle;
    if (!is_dir((string) $scanDir)) {
        fwrite(STDERR, "not a directory: {$scanDir}\n");
        exit(2);
    }

    $dirs = null !== $renameRoot ? (glob(rtrim($renameRoot, '/') . '/*', GLOB_ONLYDIR) ?: []) : [rtrim((string) $renameSingle, '/')];
    sort($dirs);
    $renamer = new StructuralTypeRenamer();
    $failures = 0;
    $changedFiles = 0;
    $seen = 0;
    foreach ($dirs as $dir) {
        $name = basename($dir);
        $yamlPath = "{$dir}/{$name}.yaml";
        if (!is_file($yamlPath)) {
            if (null !== $renameSingle) {
                echo "FAIL {$name}: no {$name}.yaml at {$dir}\n";
                $failures++;
            }
            continue;
        }
        $seen++;
        try {
            $result = $renamer->rename((string) file_get_contents($yamlPath));
        } catch (\RuntimeException $e) {
            echo "FAIL {$name}: {$e->getMessage()}\n";
            $failures++;
            continue;
        }
        if (0 === $result['renamed']) {
            echo "OK   {$name}: nothing to rename\n";
            continue;
        }
        $changedFiles++;
        if ($write && !fields_migrate_write_atomically($yamlPath, $result['source'])) {
            echo "FAIL {$name}: cannot write {$yamlPath}\n";
            $failures++;
            continue;
        }
        echo sprintf("%s %s: %d type(s) renamed%s\n", $write ? 'OK  ' : 'WOULD', $name, $result['renamed'], $write ? " -> {$yamlPath}" : '');
    }
    echo sprintf("%d definition(s), %d to rename, %d failed\n", $seen, $changedFiles, $failures);
    if (!$write && $changedFiles > 0) {
        echo "nothing written — re-run with --write to apply\n";
    }
    exit($failures > 0 ? 1 : 0);
}

// `--strip-comment` (#84) is a codemod over a component migrated BEFORE
// component migration retired the twig front-comment the way page/doc
// migration always did: the yaml exists, the comment is still sitting on
// top of the twig, so every migrated component carries its metadata twice.
// It never re-derives anything and never touches the yaml — it only removes
// a comment, and only when the yaml already says everything the comment
// says. Same shape as --rename-structural-types: prints by default, writes
// only with --write.
if (in_array('--strip-comment', $args, true)) {
    $stripUsage = "usage: fields-migrate --strip-comment [--write] <component-dir>\n"
        . "       fields-migrate --strip-comment [--write] --root=<components-root>\n"
        . "  Removes the twig front-comment from an already-migrated component (name.yaml exists)\n"
        . "  when every key the comment carries matches what name.yaml already says.\n"
        . "  Refuses a component, per key, when the yaml disagrees or lacks the key -- nothing is\n"
        . "  ever lost silently. Prints what would change and writes nothing unless --write is given.\n";
    $write = false;
    $stripRoot = null;
    $stripSingle = null;
    foreach ($args as $arg) {
        if ('--strip-comment' === $arg) {
            continue;
        }
        if ('--write' === $arg) {
            $write = true;
            continue;
        }
        if (str_starts_with($arg, '--root=')) {
            $stripRoot = substr($arg, 7);
            continue;
        }
        if (str_starts_with($arg, '-')) {
            fwrite(STDERR, "unknown option with --strip-comment: {$arg}\n" . $stripUsage);
            exit(2);
        }
        $stripSingle = $arg;
    }
    if ((null === $stripRoot) === (null === $stripSingle)) {
        fwrite(STDERR, $stripUsage);
        exit(2);
    }
    $scanDir = $stripRoot ?? $stripSingle;
    if (!is_dir((string) $scanDir)) {
        fwrite(STDERR, "not a directory: {$scanDir}\n");
        exit(2);
    }

    $dirs = null !== $stripRoot ? (glob(rtrim($stripRoot, '/') . '/*', GLOB_ONLYDIR) ?: []) : [rtrim((string) $stripSingle, '/')];
    sort($dirs);
    $matcher = new ComponentCommentMatcher();
    $reader = new TwigMetadataReader();
    $stripper = new TwigFrontCommentStripper();
    $failures = 0;
    $stripped = 0;
    $seen = 0;
    foreach ($dirs as $dir) {
        $name = basename($dir);
        $twigPath = "{$dir}/{$name}.twig";
        $yamlPath = "{$dir}/{$name}.yaml";
        if (!is_file($twigPath) || !is_file($yamlPath)) {
            if (null !== $stripSingle) {
                echo "FAIL {$name}: needs both {$name}.twig and {$name}.yaml at {$dir}\n";
                $failures++;
            }
            continue;
        }
        $twigSource = (string) file_get_contents($twigPath);
        if (!$stripper->hasFrontComment($twigSource)) {
            echo "OK   {$name}: no front-comment left to strip\n";
            continue;
        }
        $seen++;
        try {
            $yamlTree = Yaml::parseFile($yamlPath);
        } catch (\Throwable $e) {
            echo "FAIL {$name}: {$yamlPath} is not valid YAML: {$e->getMessage()}\n";
            $failures++;
            continue;
        }
        if (!is_array($yamlTree)) {
            echo "FAIL {$name}: {$yamlPath} does not contain a YAML mapping\n";
            $failures++;
            continue;
        }
        $commentMeta = $reader->read($twigSource);
        $diffs = $matcher->diff($commentMeta, $yamlTree);
        if ([] !== $diffs) {
            echo "FAIL {$name}: " . implode('; ', $diffs) . "\n";
            $failures++;
            continue;
        }
        $stripped++;
        if ($write && !fields_migrate_write_atomically($twigPath, $stripper->strip($twigSource))) {
            echo "FAIL {$name}: cannot write {$twigPath}\n";
            $failures++;
            continue;
        }
        echo sprintf("%s %s: front-comment matches %s%s\n", $write ? 'OK  ' : 'WOULD', $name, $yamlPath, $write ? ", stripped -> {$twigPath}" : '');
    }
    echo sprintf("%d component(s) with a comment to check, %d to strip, %d failed\n", $seen, $stripped, $failures);
    if (!$write && $stripped > 0) {
        echo "nothing written — re-run with --write to apply\n";
    }
    exit($failures > 0 ? 1 : 0);
}

$root = null;
$dryRun = false;
$force = false;
$single = null;
$assumeRole = null;
$drupalConfigDir = null;
$drupalDisplay = null;
$defaultCategory = null;

$usage = "usage: fields-migrate [--dry-run] [--force] [--assume-role=parent|query|global] <component-dir|page-dir|doc-dir>\n"
    . "       fields-migrate [--dry-run] [--force] [--assume-role=parent|query|global] --root=<components-root>\n"
    . "  Drupal: [--drupal-config=<config-dir>] [--drupal-display=<php-file>] [--default-category=<name>]\n"
    . "  --drupal-config reads a Drupal config export: a component whose paragraph type exists there\n"
    . "  gets kind: block and its fields from that paragraph type (see README, Drupal).\n"
    . "  --drupal-display names the PHP class that builds the template's content array; it is\n"
    . "  tokenized (never run) for the template prop name of each Drupal field.\n"
    . "  --default-category sets category: where the twig front-comment has none.\n"
    . "  --force re-derives over an existing definition, discarding whatever only it records.\n"
    . "  A directory under page/ or doc/ moves its twig front-comment into <id>.yaml\n"
    . "  (page.schema.json or doc.schema.json).\n"
    . "  --root on a page or doc root also finds nested <group>/<id>/ directories.\n"
    . "  --assume-role sets the fallback `role:` for a twig-only component's field with no\n"
    . "  explicit `role:` of its own (see AcfJsonReader::read()'s doc header). Without it, such\n"
    . "  a field's provenance is ambiguous and migration refuses the component. Ignored for an\n"
    . "  acf.json-backed component. A field's own twig `role:` annotation always wins over it.\n"
    . "       fields-migrate --rename-structural-types [--write] <component-dir>|--root=<components-root>\n"
    . "  rewrites `type: group`/`repeater` to `object`/`list` in existing definitions.\n"
    . "       fields-migrate --strip-comment [--write] <component-dir>|--root=<components-root>\n"
    . "  removes an already-migrated component's twig front-comment once name.yaml matches it.\n";

$assumableRoles = ['parent', 'query', 'global'];

foreach ($args as $arg) {
    if (str_starts_with($arg, '--root=')) {
        $root = substr($arg, 7);
        continue;
    }
    if ('--dry-run' === $arg) {
        $dryRun = true;
        continue;
    }
    if ('--force' === $arg) {
        $force = true;
        continue;
    }
    if (str_starts_with($arg, '--drupal-config=')) {
        $drupalConfigDir = substr($arg, 16);
        continue;
    }
    if (str_starts_with($arg, '--drupal-display=')) {
        $drupalDisplay = substr($arg, 17);
        continue;
    }
    if (str_starts_with($arg, '--default-category=')) {
        $defaultCategory = substr($arg, 19);
        if ('' === $defaultCategory) {
            fwrite(STDERR, "--default-category needs a value\n" . $usage);
            exit(2);
        }
        continue;
    }
    if (str_starts_with($arg, '--assume-role=')) {
        $assumeRole = substr($arg, 14);
        if (!in_array($assumeRole, $assumableRoles, true)) {
            fwrite(STDERR, sprintf(
                "invalid --assume-role '%s' — must be one of: %s.\n",
                $assumeRole,
                implode(', ', $assumableRoles),
            ) . $usage);
            exit(2);
        }
        continue;
    }
    // An unrecognised option must never fall through to $single. Both guards
    // this command offers are opt-in flags, so a typo silently drops the
    // guard: `--dryrun` writes for real, `--Force` stops short of the
    // re-derive the caller asked for. Refuse instead of guessing.
    if (str_starts_with($arg, '-')) {
        fwrite(STDERR, "unknown option: {$arg}\n" . $usage);
        exit(2);
    }
    $single = $arg;
}

if (null === $root && null === $single) {
    fwrite(STDERR, $usage);
    exit(2);
}

if (null !== $root && !is_dir($root)) {
    fwrite(STDERR, "not a directory: {$root}\n");
    exit(2);
}

// The key style governs how a component slug is spelled inside derived ACF
// keys. Resolved from the components root (not per component) because it is a
// project-wide convention: two components in one project spelling their keys
// differently is the exact split this setting exists to end.
$keyStyle = KeyStyle::discoverFor($root ?? dirname(rtrim((string) $single, '/')));

if (null !== $drupalDisplay && null === $drupalConfigDir) {
    fwrite(STDERR, "--drupal-display needs --drupal-config\n" . $usage);
    exit(2);
}
try {
    $drupal = [
        'config' => null !== $drupalConfigDir ? DrupalConfig::fromDirectory($drupalConfigDir) : null,
        'settings' => DrupalSettings::discoverFor($root ?? dirname(rtrim((string) $single, '/'))),
        'evidence' => null !== $drupalDisplay ? DisplayEvidence::fromFile($drupalDisplay) : null,
    ];
} catch (\RuntimeException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(2);
}

$results = [];
if (null !== $root) {
    $dirs = glob(rtrim($root, '/') . '/*', GLOB_ONLYDIR) ?: [];
    // The styleguide walks the page and doc trees recursively, so such a root
    // also holds `<group>/<id>/`. A group directory has no <group>.twig, and
    // a one-level glob skipped every page under it while exiting 0.
    // `_`-prefixed directories hold partials, not pages.
    $dirs = array_values(array_filter(
        $dirs,
        static fn (string $dir): bool => !(str_starts_with(basename($dir), '_') && null !== EntryDefinition::typeOfDirectory($dir)),
    ));
    // Directory symlinks are not followed below a page or doc root. Following them
    // looped forever on a link to an ancestor, and deduplicating by real
    // path kept whichever spelling glob() listed first, which could be the
    // alias, so the canonical page was never migrated.
    $pending = $dirs;
    while ([] !== $pending) {
        $dir = array_shift($pending);
        if (is_link($dir) || null === EntryDefinition::typeOfDirectory($dir)) {
            continue;
        }
        foreach (glob("{$dir}/*", GLOB_ONLYDIR) ?: [] as $child) {
            if (str_starts_with(basename($child), '_') || is_link($child)) {
                continue;
            }
            $dirs[] = $child;
            $pending[] = $child;
        }
    }
    $dirs = array_values(array_filter(
        $dirs,
        static fn (string $dir): bool => !(is_link($dir) && null !== EntryDefinition::typeOfDirectory($dir)),
    ));
    sort($dirs);
    foreach ($dirs as $dir) {
        // Everything the per-component form accepts, so a sweep and a single
        // run agree. Before this, `--root` migrated only acf.json components
        // and silently passed over the block-only ones the CLI had accepted
        // one at a time since 0.4.2.
        $name = basename($dir);
        if (is_file("{$dir}/acf.json") || is_file("{$dir}/block.json") || is_file("{$dir}/{$name}.twig")) {
            $results[] = fields_migrate_one($dir, $dryRun, $force, $keyStyle, $assumeRole, $drupal, $defaultCategory);
        }
    }
} else {
    $results[] = fields_migrate_one($single, $dryRun, $force, $keyStyle, $assumeRole, $drupal, $defaultCategory);
}

$failures = 0;
foreach ($results as $result) {
    if ($result['ok']) {
        echo isset($result['skipped'])
            ? "SKIP {$result['component']}: {$result['skipped']}\n"
            : "OK   {$result['component']}" . (isset($result['out']) ? " -> {$result['out']}" : '')
                . (isset($result['note']) ? " ({$result['note']})" : '') . "\n";
        continue;
    }
    $failures++;
    echo "FAIL {$result['component']}: {$result['error']}\n";
}
echo sprintf("%d component(s), %d failed\n", count($results), $failures);

exit($failures > 0 ? 1 : 0);
